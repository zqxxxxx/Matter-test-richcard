# Copy to seed.env on the target host. Do not commit seed.env.

COMPOSE_DIR=/opt/octo-richcard/octo-deployment/docker
COMPOSE_PROJECT_NAME=octo-richcard

PUBLIC_BASE_URL=http://127.0.0.1:443
EXTERNAL_LINK_URL=https://www.deepseek.com/

# LLM gateway for real Matter extraction and Smart Summary generation.
# Put the real key in seed.env or the deployment docker .env; do not commit it.
LLM_API_URL=https://llm-gateway.mlamp.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

DEMO_SPACE_ID=rc_demo_space
DEMO_GROUP_NO=rc_demo_group_contract
DEMO_GROUP_NAME="Richcard 验收群"

DEMO_PASSWORD=Octo@123456
DEMO_SENDER_UID=rc_demo_pm
DEMO_SUMMARY_CREATOR_UID=rc_demo_legal

DEMO_MATTER_OPEN_ID=11111111-1111-4111-8111-111111111111
DEMO_MATTER_REVIEW_ID=44444444-4444-4444-8444-444444444444
DEMO_MATTER_DONE_ID=22222222-2222-4222-8222-222222222222
DEMO_MATTER_BLOCKED_ID=33333333-3333-4333-8333-333333333333
DEMO_PROJECT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

# Summary cards need a real numeric summary task id from summary-api.
# Leave empty until summary-api has been enabled and seeded/created.
DEMO_SUMMARY_TASK_ID=
DEMO_SUMMARY_ACTION_TASK_ID=
DEMO_SUMMARY_REJECT_TASK_ID=
